<div class="download-split" aria-label="{{ project.title }} App 下载">
  <button class="product-link download-primary" type="button" data-channel="stable" disabled title="App 正式版直链尚未接入" aria-label="{{ project.title }} App 下载，正式版直链尚未接入">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 15v5h14v-5"/></svg>
    <span class="download-version" data-download-version="stable">未发布</span><span>App 下载</span>
  </button>
  <details class="download-options">
    <summary class="download-toggle" aria-label="更多 App 下载选项" aria-controls="{{ project.id }}-download-menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
    <div class="download-menu" id="{{ project.id }}-download-menu">
      <button class="download-option" type="button" data-channel="dev" disabled><span class="download-option-title">App · Dev build</span><span class="download-option-note">直链尚未接入</span></button>
    </div>
  </details>
</div>
