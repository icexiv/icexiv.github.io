<div class="download-controls" aria-label="{{ project.title }} App 下载" data-download-manifest="{{ site.data.deployment.manifest }}" data-download-source="{{ site.data.deployment.source }}">
  {% for channel in ["stable", "dev"] %}
  <div class="download-split" data-download-channel="{{ channel }}">
    <a class="product-link download-primary" data-channel="{{ channel }}" aria-disabled="true" tabindex="-1" title="正在读取下载信息">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 15v5h14v-5"/></svg>
      <span class="download-copy">
        <span class="download-title">{% if channel == "stable" %}正式版{% else %}Dev build{% endif %} <span class="download-version" data-download-version="{{ channel }}">读取中</span></span>
        <span class="download-filename">正在读取下载信息</span>
      </span>
    </a>
    <details class="download-options">
      <summary class="download-toggle" aria-label="{% if channel == 'stable' %}正式版{% else %}Dev build{% endif %}其他平台下载" aria-controls="{{ project.id }}-{{ channel }}-download-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="download-menu" id="{{ project.id }}-{{ channel }}-download-menu">
        <p class="download-menu-label">其他平台</p>
        {% for platform in ["windows-x86_64", "linux-x86_64", "macos-aarch64"] %}
        <a class="download-option" data-platform="{{ platform }}" aria-disabled="true" tabindex="-1">
          <span class="download-option-title">{% if platform == "windows-x86_64" %}Windows · x86_64{% elif platform == "linux-x86_64" %}Linux · x86_64{% else %}macOS · Apple Silicon（实验）{% endif %}</span>
          <span class="download-option-note">正在读取</span>
        </a>
        {% endfor %}
      </div>
    </details>
  </div>
  {% endfor %}
  <div class="download-feedback"><p class="download-status" role="status" aria-live="polite">正在识别平台、读取下载信息</p><button class="download-retry" type="button" hidden>重试</button></div>
  <noscript><p class="download-status">需要启用 JavaScript 才能读取下载清单。</p></noscript>
</div>
