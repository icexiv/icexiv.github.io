<span class="icon {{ project.icon }}-icon">
{% if project.icon == "market" %}
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="5" y="18" width="4" height="8" rx="1.5" fill="currentColor" opacity=".4"/>
    <rect x="14" y="13" width="4" height="13" rx="1.5" fill="currentColor" opacity=".65"/>
    <rect x="23" y="6" width="4" height="20" rx="1.5" fill="currentColor"/>
    <path d="m6.5 12 8-5.5 4.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{% elif project.icon == "db" %}
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m16 5 11 6-11 6-11-6Z" fill="currentColor" fill-opacity=".09"/>
    <path d="m5 16 11 6 11-6" opacity=".75"/><path d="m5 21 11 6 11-6" opacity=".45"/>
  </svg>
{% else %}
  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="16" cy="16" r="10" opacity=".55"/><ellipse cx="16" cy="16" rx="4.5" ry="10"/>
    <path d="M6 16h20M8 10.5c5 2 11 2 16 0M8 21.5c5-2 11-2 16 0" opacity=".7"/>
    <path d="m24.5 3 .7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7Z" fill="currentColor" stroke="none"/>
  </svg>
{% endif %}
</span>
