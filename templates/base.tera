<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="IceXIV · FF14 工具集">
    <meta name="theme-color" content="#ffffff">
    <title>{{ page.title }}</title>
    <link rel="icon" href="{{ url(path='logo.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ url(path='style.css') }}?rev={{ site.data.revisions['style.css'] }}">
    <script src="{{ url(path='projects.js') }}?rev={{ site.data.revisions['projects.js'] }}" defer></script>
    <script src="{{ url(path='downloads.js') }}?rev={{ site.data.revisions['downloads.js'] }}" defer></script>
    {% if site.data.deployment.target == "cn" %}<script src="{{ url(path='_analytics/tracker.js') }}" defer referrerpolicy="no-referrer"></script>{% endif %}
    <noscript><style>.project-panel[hidden] { display: block !important; } .carousel-controls, .project-pagination { display: none; } .project-track { gap: 16px; } .project-card { transform: none !important; margin-left: 0 !important; }</style></noscript>
  </head>
  <body>
    <div class="site">
      <header class="header page-width">
        <div class="brand">
          <img class="brand-mark" src="{{ url(path='logo.svg') }}" width="29" height="29" alt="">
          <span>IceXIV</span>
        </div>
        <a class="github" href="https://github.com/icexiv" aria-label="GitHub 组织：icexiv">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path id="github-mark" d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.63 0c2.15-1.45 3.09-1.15 3.09-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.8 1.15 3.03 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z"/></svg>
          <span>icexiv</span>
        </a>
      </header>
      <main>{% block content %}{% endblock content %}</main>
      <footer class="footer page-width"><span>IceXIV</span><span>Azur冰弦@宇宙和音</span></footer>
      {% if site.data.deployment.target == "cn" %}
      <div class="legal-footer page-width">
        {% if site.data.deployment.icp %}<a href="{{ site.data.deployment.icp_url }}" target="_blank" rel="noopener noreferrer">{{ site.data.deployment.icp }}</a>{% endif %}
        {% if site.data.deployment.police %}<a class="legal-police" href="{{ site.data.deployment.police_url }}" target="_blank" rel="noreferrer"><img src="{{ url(path=site.data.deployment.police_icon) }}" width="18" height="20" alt="">{{ site.data.deployment.police }}</a>{% endif %}
      </div>
      {% endif %}
    </div>
  </body>
</html>
